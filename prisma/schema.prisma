generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String              @id @default(cuid())
  name          String?
  email         String              @unique
  emailVerified DateTime?
  image         String?
  password      String?
  accounts      Account[]
  sessions      Session[]
  Authenticator Authenticator[]
  Listener      Listener?
  debateEntries DebateParticipant[]
  debateVotes   DebateVote[]
  roasts        Roast[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model Listener {
  id            String   @id @default(cuid())
  tagline       String?
  likes         Int      @default(0)
  interests     String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listenerStats Stats?

  @@index([likes])
}

model Stats {
  id                String   @id @default(cuid())
  elo               Int      @default(1000)
  logicScore        Float    @default(0)
  overallScore      Float    @default(0)
  persuasionScore   Float    @default(0)
  factCheckAccuracy Float    @default(0)
  aiFeedbackSummary String?
  debatesPlayed     Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  listenerId        String   @unique
  listener          Listener @relation(fields: [listenerId], references: [id], onDelete: Cascade)

  @@index([elo])
  @@index([overallScore])
}

model Debate {
  id            String              @id @default(cuid())
  title         String
  status        DebateStatus        @default(Waiting)
  spectators    Int                 @default(0)
  startedAt     DateTime?
  turnStartedAt DateTime?
  activeUserId  String?
  createdAt     DateTime            @default(now())
  participants  DebateParticipant[]
  turns         DebateTurn[]
  votes         DebateVote[]
}

enum DebateStatus {
  Waiting
  Live
  Completed
  Cancelled
}

enum DebateRole {
  Creator
  Opponent
}

model DebateParticipant {
  id                String       @id @default(cuid())
  debateId          String
  debate            Debate       @relation(fields: [debateId], references: [id], onDelete: Cascade)
  userId            String
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role              DebateRole
  overallScore      Float?
  logicScore        Float?
  persuasionScore   Float?
  factCheckAccuracy Float?
  feedbackSummary   String?
  turns             DebateTurn[]
  votesReceived     DebateVote[] @relation("VotedFor")

  @@unique([debateId, userId])
  @@unique([debateId, role])
  @@index([userId])
}

model DebateTurn {
  id            String            @id @default(cuid())
  debateId      String
  debate        Debate            @relation(fields: [debateId], references: [id], onDelete: Cascade)
  participantId String
  participant   DebateParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  content       String
  turnIndex     Int
  createdAt     DateTime          @default(now())

  @@unique([debateId, turnIndex])
  @@index([debateId])
}

model DebateVote {
  id            String            @id @default(cuid())
  debateId      String
  debate        Debate            @relation(fields: [debateId], references: [id], onDelete: Cascade)
  voterId       String
  voter         User              @relation(fields: [voterId], references: [id], onDelete: Cascade)
  participantId String
  participant   DebateParticipant @relation("VotedFor", fields: [participantId], references: [id], onDelete: Cascade)
  createdAt     DateTime          @default(now())

  @@unique([debateId, voterId])
  @@index([participantId])
}

model Roast {
  id         String      @id @default(cuid())
  title      String
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages   Message[]
  createdAt  DateTime    @default(now())
  roastStats RoastStats?

  @@index([userId])
}

model Message {
  id         String        @id @default(cuid())
  roastId    String
  roast      Roast         @relation(fields: [roastId], references: [id], onDelete: Cascade)
  content    String
  roastLevel Int?
  logicCheck String?
  burnScore  Int?
  sender     MessageSender
  prompt     String?
  createdAt  DateTime      @default(now())

  @@index([roastId])
}

model RoastStats {
  id                String  @id @default(cuid())
  overallScore      Float   @default(0)
  persuasionScore   Float   @default(0)
  aiFeedbackSummary String?
  roastId           String  @unique
  roast             Roast   @relation(fields: [roastId], references: [id], onDelete: Cascade)
}

enum MessageSender {
  AI
  User
}
